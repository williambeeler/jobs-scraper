{
    "name": "williambeeler/crm",
    "version": "0.1.0",
    "description": "A reusable CRM package for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "league/csv": "^9.27",
        "maatwebsite/excel": "^3.1",
        "prism-php/prism": "^0.99.19",
        "spatie/laravel-backup": "^10.0",
        "spatie/laravel-tags": "^4.10",
        "tightenco/ziggy": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "WilliamBeeler\\Crm\\": "src/",
            "WilliamBeeler\\Crm\\Database\\Factories\\": "database/factories/",
            "WilliamBeeler\\Crm\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilliamBeeler\\Crm\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WilliamBeeler\\Crm\\Providers\\CrmServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
